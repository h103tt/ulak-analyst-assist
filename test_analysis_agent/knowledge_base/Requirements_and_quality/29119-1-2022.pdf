<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="XMP Core 5.1.2">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Â© ISO ISO  pub-date year</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The purpose of the ISO/IEC/IEEE 29119 series of software testing standards is to define an internationally-agreed set of standards for software testing that can be used by any organization when performing any form of software testing. ISO/IEC/IEEE 29119-1 facilitates the use of the other ISO/IEC/IEEE 29119 standards by introducing the general concepts on which these standards are&#xD;&#xA;built. ISO/IEC/IEEE 29119-1 is informative, providing a starting point, context, and guidance for the other parts.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>29119</rdf:li>
               <rdf:li>29119-1</rdf:li>
               <rdf:li>software testing</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">ï»¿ISO/IEC/IEEE 29119-1-2022ï»¿, Software and systems engineering â€” Software testing â€” Part 1: General Concepts</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>IEEE Computer Society/Software &amp; Systems Engineering Standards Committee (C/S2ESC)</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
